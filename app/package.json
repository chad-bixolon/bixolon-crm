{
  "name": "bixolon-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "postinstall": "npm run prisma:generate",
    "predev": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "typecheck": "npm run prisma:generate && tsc --noEmit --incremental false",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed-stages": "node scripts/seed-sales-stages.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e:prepare": "node e2e/prepare.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:headed": "node e2e/run.mjs --headed",
    "test:e2e:ui": "node e2e/run.mjs --ui",
    "test:e2e:reset": "docker compose -f ../compose.e2e.yml -p saleshub-e2e down -v",
    "db:seed-activity-types": "node scripts/seed-activity-types.mjs",
    "storage:check": "node scripts/operations/check-document-storage.mjs",
    "audit:production-cleanup": "node scripts/operations/audit-production-cleanup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
