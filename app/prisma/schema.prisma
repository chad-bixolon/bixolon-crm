// Prisma 6.19.3. SQL-only checks and the primary-contact partial index live in migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_MANAGER
  SALES
  MARKETING_MANAGER
  READ_ONLY
}

enum IdentityProvider {
  GOOGLE
}

enum AccountBusinessRoleCode {
  END_USER
  DISTRIBUTOR
  VAR
  ISV
  OEM
  PARTNER
  MEDIA_PARTNER
}

enum OpportunityPartyRole {
  END_USER
  VAR_RESELLER
  DISTRIBUTOR
  ISV_PARTNER
  OEM
  OTHER
  MEDIA_PARTNER
  SERVICE_PARTNER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPartyRole {
  PROGRAM_OWNER
  END_CUSTOMER
  DISTRIBUTOR
  VAR_RESELLER
  INTEGRATOR
  ISV
  OEM
  SERVICE_PROVIDER
  CONNECTIVITY_PROVIDER
  IMPLEMENTATION_PARTNER
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
  NA
}

enum ForecastCategory {
  OMITTED
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
}

enum SalesQuarter {
  Q1
  Q2
  Q3
  Q4
}

enum PriceExceptionStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum PriceExceptionSourceType {
  LEGACY_WORKBOOK
  EXTERNAL_EXPORT
}

enum OpportunityProductPriceSource {
  MANUAL
  CATALOG
  PRICE_EXCEPTION
  ODM_CUSTOMER
}

enum OdmCustomerPriceSource {
  MANUAL
  GARY_WORKBOOK
}

enum ReportType {
  PIPELINE
  ACCOUNT_ACTIVITY
  PRODUCT_PERFORMANCE
  CHANNEL_PARTNER
  PROJECT_INITIATIVE
  PRICE_EXCEPTION_USAGE
  TRADE_SHOW
}

enum ReportVisibility {
  PERSONAL
  SHARED
}

enum MarketingPreference {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MarketingAudienceContactOverrideKind {
  INCLUDE
  EXCLUDE
}

enum TradeShowLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum TradeShowLeadRouting {
  UNREVIEWED
  BIXOLON_SALES
  REFERRED_TO_PARTNER
  MARKETING_FOLLOW_UP
}

enum TradeShowImportFormat {
  NRA_NRF
  XPRESSLEADS_MODEX
  CUSTOM_MAPPING
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  firstName               String
  lastName                String
  active                  Boolean            @default(true)
  role                    UserRole           @default(READ_ONLY)
  archivedAt              DateTime?
  identities              ExternalIdentity[]
  ownedAccounts           Account[]          @relation("AccountOwner")
  opportunities           Opportunity[]      @relation("OpportunityOwner")
  tasks                   Task[]             @relation("TaskAssignee")
  activities              Activity[]         @relation("ActivityUser")
  createdAccounts         Account[]          @relation("AccountCreatedBy")
  updatedAccounts         Account[]          @relation("AccountUpdatedBy")
  archivedAccounts        Account[]          @relation("AccountArchivedBy")
  createdContacts         Contact[]          @relation("ContactCreatedBy")
  updatedContacts         Contact[]          @relation("ContactUpdatedBy")
  archivedContacts        Contact[]          @relation("ContactArchivedBy")
  createdOpportunities    Opportunity[]      @relation("OpportunityCreatedBy")
  updatedOpportunities    Opportunity[]      @relation("OpportunityUpdatedBy")
  archivedOpportunities   Opportunity[]      @relation("OpportunityArchivedBy")
  createdTasks            Task[]             @relation("TaskCreatedBy")
  updatedTasks            Task[]             @relation("TaskUpdatedBy")
  archivedTasks           Task[]             @relation("TaskArchivedBy")
  createdActivities       Activity[]         @relation("ActivityCreatedBy")
  updatedActivities       Activity[]         @relation("ActivityUpdatedBy")
  archivedActivities      Activity[]         @relation("ActivityArchivedBy")
  createdNotes            Note[]             @relation("NoteCreatedBy")
  updatedNotes            Note[]             @relation("NoteUpdatedBy")
  archivedNotes           Note[]             @relation("NoteArchivedBy")
  ownedProjects           Project[]          @relation("ProjectOwner")
  createdProjects         Project[]          @relation("ProjectCreatedBy")
  updatedProjects         Project[]          @relation("ProjectUpdatedBy")
  createdPriceExceptions  PriceException[]   @relation("PriceExceptionCreatedBy")
  updatedPriceExceptions  PriceException[]   @relation("PriceExceptionUpdatedBy")
  assignedPriceExceptions PriceException[]   @relation("PriceExceptionAssignedSalesRep")
  ownedReports            ReportDefinition[] @relation("ReportOwner")
  createdReports          ReportDefinition[] @relation("ReportCreatedBy")
  updatedReports          ReportDefinition[] @relation("ReportUpdatedBy")
  marketingPreferenceUpdates Contact[]        @relation("ContactMarketingPreferenceUpdatedBy")
  ownedMarketingAudiences MarketingAudience[] @relation("MarketingAudienceOwner")
  createdMarketingAudiences MarketingAudience[] @relation("MarketingAudienceCreatedBy")
  updatedMarketingAudiences MarketingAudience[] @relation("MarketingAudienceUpdatedBy")
  salesTargets            SalesTarget[]      @relation("SalesTargetRep")
  createdSalesTargets     SalesTarget[]      @relation("SalesTargetCreatedBy")
  updatedSalesTargets     SalesTarget[]      @relation("SalesTargetUpdatedBy")
  marketingTradeShows     TradeShow[]        @relation("TradeShowMarketingOwner")
  createdTradeShows       TradeShow[]        @relation("TradeShowCreatedBy")
  updatedTradeShows       TradeShow[]        @relation("TradeShowUpdatedBy")
  archivedTradeShows      TradeShow[]        @relation("TradeShowArchivedBy")
  tradeShowImports        TradeShowImport[]  @relation("TradeShowImportUploader")
  createdTradeShowImportMappings TradeShowImportMapping[] @relation("TradeShowImportMappingCreator")
  updatedTradeShowImportMappings TradeShowImportMapping[] @relation("TradeShowImportMappingUpdater")
  assignedTradeShowLeads  TradeShowLead[]    @relation("TradeShowLeadSalesRep")
  referredTradeShowLeads  TradeShowLead[]    @relation("TradeShowLeadReferrer")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

/// A saved, validated query against a curated BIXOLON report type. Results are never persisted.
model ReportDefinition {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  reportType    ReportType
  ownerId       Int
  owner         User             @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  visibility    ReportVisibility @default(PERSONAL)
  configuration Json
  archivedAt    DateTime?
  createdById   Int
  createdBy     User             @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?            @relation("ReportUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([ownerId, archivedAt])
  @@index([visibility, reportType, archivedAt])
  @@index([createdById])
  @@index([updatedById])
}

/// A reusable, validated Contact-grain query. Membership is resolved live, then overrides are applied.
model MarketingAudience {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  ownerId       Int
  owner         User             @relation("MarketingAudienceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  visibility    ReportVisibility @default(PERSONAL)
  filterConfig  Json
  archivedAt    DateTime?
  createdById   Int
  createdBy     User             @relation("MarketingAudienceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?            @relation("MarketingAudienceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  overrides     MarketingAudienceContactOverride[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([ownerId, archivedAt])
  @@index([visibility, archivedAt])
  @@index([createdById])
  @@index([updatedById])
}

model ExternalIdentity {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider  IdentityProvider @default(GOOGLE)
  issuer    String
  subject   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([issuer, subject])
  @@unique([userId, provider])
}

model Account {
  id                         Int                   @id @default(autoincrement())
  name                       String
  status                     AccountStatus         @default(ACTIVE)
  strategicAccount           Boolean               @default(false)
  /// Deprecated compatibility value; businessRoles is authoritative after migration.
  accountType                String?
  /// Existing values become stable lookup codes without normalization or rewriting.
  industry                   String?
  industryCategory           Industry?             @relation(fields: [industry], references: [code], onDelete: Restrict, onUpdate: Restrict)
  territory                  String?
  territoryCategory          Territory?            @relation(fields: [territory], references: [code], onDelete: Restrict, onUpdate: Restrict)
  website                    String?
  phone                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  stateProvince              String?
  postalCode                 String?
  country                    String?
  ownerId                    Int?
  owner                      User?                 @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  businessRoles              AccountBusinessRole[]
  contacts                   Contact[]
  tradeShowLeads             TradeShowLead[] @relation("TradeShowLeadAccount")
  routedTradeShowLeads       TradeShowLead[] @relation("TradeShowLeadRoutedPartner")
  /// Legacy direct opportunity relationships retained for compatibility only.
  opportunities              Opportunity[]         @relation("LegacyOpportunityAccount")
  opportunityMemberships     OpportunityAccount[]
  primaryProjects            Project[]             @relation("ProjectPrimaryAccount")
  projectMemberships         ProjectAccount[]
  tasks                      Task[]
  activities                 Activity[]
  notes                      Note[]
  distributorPriceExceptions PriceException[]      @relation("PriceExceptionDistributor")
  varPriceExceptions         PriceException[]      @relation("PriceExceptionVar")
  endUserPriceExceptions     PriceException[]      @relation("PriceExceptionEndUser")
  odmSkus                    ProductSkuOdmCustomer[]
  archivedAt                 DateTime?
  createdById                Int?
  createdBy                  User?                 @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById                Int?
  updatedBy                  User?                 @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById               Int?
  archivedBy                 User?                 @relation("AccountArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@index([name])
  @@index([ownerId, status])
  @@index([territory, status])
  @@index([industry])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model AccountBusinessRole {
  accountId Int
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  role      AccountBusinessRoleCode
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@id([accountId, role])
  @@index([role, accountId])
}

model Industry {
  code      String    @id
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Territory {
  code      String    @id
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityType {
  code       String     @id
  name       String     @unique
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model TerminologyLabel {
  key          String   @id
  displayLabel String
  changedById  Int?
  changedAt    DateTime @default(now())
}

model SystemSetting {
  key         String   @id
  value       Int
  changedById Int?
  changedAt   DateTime @default(now())
}

model Contact {
  id            Int               @id @default(autoincrement())
  accountId     Int?
  account       Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  activityLinks ActivityContact[]
  opportunityLinks OpportunityContact[]
  tradeShowLeads TradeShowLead[]
  firstName     String
  lastName      String
  title         String?
  email         String?
  phone         String?
  mobile        String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?
  active        Boolean           @default(true)
  marketingPreference MarketingPreference @default(UNKNOWN)
  marketingPreferenceUpdatedAt DateTime?
  marketingPreferenceUpdatedByUserId Int?
  marketingPreferenceUpdatedBy User? @relation("ContactMarketingPreferenceUpdatedBy", fields: [marketingPreferenceUpdatedByUserId], references: [id], onDelete: Restrict)
  /// SQL enforces one primary contact per account, active, unarchived, and assigned.
  isPrimary     Boolean           @default(false)
  archivedAt    DateTime?
  createdById   Int?
  createdBy     User?             @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?             @relation("ContactUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById  Int?
  archivedBy    User?             @relation("ContactArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  marketingAudienceOverrides MarketingAudienceContactOverride[]

  @@index([accountId, active])
  @@index([marketingPreference, active, archivedAt])
  @@index([marketingPreferenceUpdatedByUserId])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model MarketingAudienceContactOverride {
  audienceId Int
  audience   MarketingAudience @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  contactId  Int
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  kind       MarketingAudienceContactOverrideKind
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([audienceId, contactId])
  @@index([contactId, audienceId])
  @@index([audienceId, kind])
}

model SalesStage {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  sortOrder     Int
  probability   Int           @default(0)
  isClosed      Boolean       @default(false)
  isWon         Boolean       @default(false)
  active        Boolean       @default(true)
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active, sortOrder])
}

model CompetitorOption {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  opportunities Opportunity[]
  tradeShowLeads TradeShowLead[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active, sortOrder])
}

model Currency {
  code          String        @id @db.Char(3)
  name          String
  active        Boolean       @default(true)
  opportunities Opportunity[]
  salesTargets  SalesTarget[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Opportunity {
  id                      Int                  @id @default(autoincrement())
  projects                OpportunityProject[]
  originatingTradeShowLead TradeShowLead?
  contacts                OpportunityContact[]
  /// Original column is retained; participants is the authoritative account relationship.
  legacyAccountId         Int?                 @map("accountId")
  legacyAccount           Account?             @relation("LegacyOpportunityAccount", fields: [legacyAccountId], references: [id], onDelete: Restrict, map: "Opportunity_accountId_fkey")
  ownerId                 Int?
  owner                   User?                @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stageId                 Int
  stage                   SalesStage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  name                    String
  description             String?
  competitorId            Int?
  competitor              CompetitorOption?    @relation(fields: [competitorId], references: [id], onDelete: Restrict)
  currentProductBeingUsed String?
  customerPainPoints      String?              @db.Text
  expectedCloseDate       DateTime?
  probability             Int?
  forecastCategory        ForecastCategory     @default(PIPELINE)
  currencyCode            String               @default("USD") @db.Char(3)
  currency                Currency             @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  participants            OpportunityAccount[]
  products                OpportunityProduct[]
  tasks                   Task[]
  activities              Activity[]
  notes                   Note[]
  archivedAt              DateTime?
  createdById             Int?
  createdBy               User?                @relation("OpportunityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById             Int?
  updatedBy               User?                @relation("OpportunityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById            Int?
  archivedBy              User?                @relation("OpportunityArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([legacyAccountId])
  @@index([ownerId, stageId])
  @@index([ownerId, expectedCloseDate, currencyCode])
  @@index([stageId, expectedCloseDate])
  @@index([expectedCloseDate])
  @@index([currencyCode])
  @@index([competitorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model SalesTarget {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation("SalesTargetRep", fields: [userId], references: [id], onDelete: Restrict)
  year         Int
  quarter      SalesQuarter
  currencyCode String       @db.Char(3)
  currency     Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  targetAmount Decimal      @db.Decimal(18, 2)
  notes        String?
  archivedAt   DateTime?
  createdById  Int
  createdBy    User         @relation("SalesTargetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById  Int?
  updatedBy    User?        @relation("SalesTargetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, year, quarter, currencyCode, archivedAt])
  @@index([year, quarter, currencyCode, archivedAt])
}

model OpportunityAccount {
  opportunityId Int
  accountId     Int
  opportunity   Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  account       Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  roles         OpportunityAccountRole[]
  tasks         Task[]                   @relation("TaskMembership")
  notes         Note[]                   @relation("NoteMembership")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@id([opportunityId, accountId])
  @@index([accountId, opportunityId])
}

model OpportunityAccountRole {
  opportunityId Int
  accountId     Int
  role          OpportunityPartyRole
  membership    OpportunityAccount   @relation(fields: [opportunityId, accountId], references: [opportunityId, accountId], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@id([opportunityId, accountId, role])
  @@index([role, opportunityId])
}

model OpportunityContact {
  opportunityId Int
  contactId     Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@id([opportunityId, contactId])
  @@index([contactId, opportunityId])
}

model Product {
  id            Int                  @id @default(autoincrement())
  sku           String               @unique
  name          String
  categoryId    Int?
  category      ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active        Boolean              @default(true)
  archivedAt    DateTime?
  opportunities OpportunityProduct[]
  skus          ProductSku[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([categoryId])
}

model ProductSku {
  id                   Int                   @id @default(autoincrement())
  productId            Int
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  partNumber           String
  normalizedPartNumber String                @unique
  description          String?
  catalogSource        ProductCatalogSource?
  odmSubtype           OdmCustomizationSubtype?
  odmCustomers         ProductSkuOdmCustomer[]
  odmCustomerSourceName String?
  baseSkuId            Int?
  baseSku              ProductSku?           @relation("OdmBaseSku", fields: [baseSkuId], references: [id], onDelete: Restrict)
  derivedOdmSkus       ProductSku[]          @relation("OdmBaseSku")
  odmDescription       String?
  priceUnit            ProductPriceUnit      @default(EACH)
  active               Boolean               @default(true)
  prices               ProductPrice[]
  opportunityProducts  OpportunityProduct[]
  priceExceptionLines  PriceExceptionLine[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([productId])
  @@index([catalogSource, productId])
  @@index([baseSkuId])
}

model ProductSkuOdmCustomer {
  skuId              Int
  accountId          Int
  sourceCustomerName String?
  sku                ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  account            Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  prices             ProductSkuOdmCustomerPrice[]
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@id([skuId, accountId])
  @@index([accountId])
}

/// Commercial revisions belong to one SKU/Account association. Exactly one unarchived
/// revision is enforced by a partial unique index in the migration.
model ProductSkuOdmCustomerPrice {
  id                 Int @id @default(autoincrement())
  skuId              Int
  accountId          Int
  odmCustomer        ProductSkuOdmCustomer @relation(fields: [skuId, accountId], references: [skuId, accountId], onDelete: Restrict)
  currencyCode       String @db.VarChar(3)
  customerPrice      Decimal @db.Decimal(12, 2)
  previousPrice      Decimal? @db.Decimal(12, 2)
  tariffPercent      Decimal @db.Decimal(9, 4)
  tariffAmount       Decimal @db.Decimal(12, 2)
  finalUnitPrice     Decimal @db.Decimal(12, 2)
  effectiveDate      DateTime? @db.Date
  notes              String?
  sourceType         OdmCustomerPriceSource
  sourceMetadata     Json?
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  opportunityProducts OpportunityProduct[]

  @@index([skuId, accountId, archivedAt])
  @@index([accountId, currencyCode, archivedAt])
}

/// A finalized commercial price exception imported from an operational source.
/// sourceKey, not peCode, is the stable import identity because legacy codes are reused.
model PriceException {
  id                     Int                      @id @default(autoincrement())
  peCode                 String?
  predecessorPeCode      String?
  status                 PriceExceptionStatus
  sourceType             PriceExceptionSourceType
  sourceKey              String
  distributorAccountId   Int?
  distributorAccount     Account?                 @relation("PriceExceptionDistributor", fields: [distributorAccountId], references: [id], onDelete: Restrict)
  varAccountId           Int?
  varAccount             Account?                 @relation("PriceExceptionVar", fields: [varAccountId], references: [id], onDelete: Restrict)
  endUserAccountId       Int?
  endUserAccount         Account?                 @relation("PriceExceptionEndUser", fields: [endUserAccountId], references: [id], onDelete: Restrict)
  distributorSourceName  String?
  varSourceName          String?
  endUserSourceName      String?
  distributorSalesRep    String?
  sourceSalesRepName     String?
  sourceSalesRepEmail    String?
  assignedSalesRepUserId Int?
  assignedSalesRepUser   User?                    @relation("PriceExceptionAssignedSalesRep", fields: [assignedSalesRepUserId], references: [id], onDelete: SetNull)
  effectiveDate          DateTime?                @db.Date
  expirationDate         DateTime?                @db.Date
  sourceDescription      String?
  competitor             String?
  sourceFileName         String?
  sourceSheet            String?
  sourceMetadata         Json?
  lines                  PriceExceptionLine[]
  archivedAt             DateTime?
  createdById            Int?
  createdBy              User?                    @relation("PriceExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById            Int?
  updatedBy              User?                    @relation("PriceExceptionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([sourceType, sourceKey])
  @@index([peCode])
  @@index([status, expirationDate])
  @@index([distributorAccountId])
  @@index([varAccountId])
  @@index([endUserAccountId])
  @@index([assignedSalesRepUserId])
  @@index([archivedAt])
}

model PriceExceptionLine {
  id                  Int                  @id @default(autoincrement())
  priceExceptionId    Int
  priceException      PriceException       @relation(fields: [priceExceptionId], references: [id], onDelete: Restrict)
  sourceLineKey       String
  productSkuId        Int?
  productSku          ProductSku?          @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  opportunityProducts OpportunityProduct[]
  sourceSku           String?
  approvedUnitPrice   Decimal?             @db.Decimal(12, 2)
  currencyCode        String               @default("USD") @db.VarChar(3)
  sourceQuantity      Decimal?             @db.Decimal(14, 3)
  sourceQuantityRaw   String?
  sourceUnit          String?
  comments            String?
  competitor          String?
  sortOrder           Int                  @default(0)
  sourceMetadata      Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([priceExceptionId, sourceLineKey])
  @@index([productSkuId, priceExceptionId])
  @@index([priceExceptionId, sortOrder])
}

enum ProductCatalogSource {
  PRICE_LIST
  PE_LIST
  SPECIAL_SKU_LIST
  ODM
}

enum OdmCustomizationSubtype {
  CUSTOMER_SPECIFIC
  SPECIAL_CONFIGURATION
  CABLE_PACKAGING_ACCESSORY
  OTHER
  LEGACY_SPECIAL_SKU
}

enum ProductPriceUnit {
  EACH
  CASE
  BOX
  ROLL
}

enum ProductPriceTier {
  STANDARD
  MSRP
  RESELLER
  DISTRIBUTOR
}

model ProductPrice {
  id           Int              @id @default(autoincrement())
  skuId        Int
  sku          ProductSku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  tier         ProductPriceTier
  currencyCode String           @db.VarChar(3)
  amount       Decimal          @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([skuId, currencyCode, tier])
}

model OpportunityProduct {
  id                         Int                           @id @default(autoincrement())
  opportunityId              Int
  opportunity                Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  productId                  Int
  product                    Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  skuId                      Int?
  sku                        ProductSku?                   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  quantity                   Int
  estimatedUnitPrice         Decimal                       @map("unitPrice") @db.Decimal(12, 2)
  priceSource                OpportunityProductPriceSource @default(MANUAL)
  catalogPriceTier           ProductPriceTier?
  priceExceptionLineId       Int?
  priceExceptionLine         PriceExceptionLine?           @relation(fields: [priceExceptionLineId], references: [id], onDelete: Restrict)
  priceExceptionCode         String?
  priceExceptionUnitPrice    Decimal?                      @db.Decimal(12, 2)
  priceExceptionCurrencyCode String?                       @db.VarChar(3)
  priceExceptionSourceQty    String?
  odmCustomerPriceId         Int?
  odmCustomerPrice           ProductSkuOdmCustomerPrice? @relation(fields: [odmCustomerPriceId], references: [id], onDelete: Restrict)
  odmCustomerAccountId       Int?
  odmCustomerBasePrice       Decimal? @db.Decimal(12, 2)
  odmCustomerTariffPercent   Decimal? @db.Decimal(9, 4)
  odmCustomerTariffAmount    Decimal? @db.Decimal(12, 2)
  odmCustomerFinalUnitPrice  Decimal? @db.Decimal(12, 2)
  odmCustomerCurrencyCode    String? @db.VarChar(3)
  odmCustomerEffectiveDate   DateTime? @db.Date
  archivedAt                 DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@index([opportunityId, archivedAt])
  @@index([productId])
  @@index([skuId])
  @@index([priceSource])
  @@index([priceExceptionLineId])
  @@index([odmCustomerPriceId])
  @@index([odmCustomerAccountId])
}

model Task {
  id            Int                 @id @default(autoincrement())
  projectId     Int?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createKey     String?             @unique @db.Uuid
  accountId     Int?
  account       Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  opportunityId Int?
  opportunity   Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  /// MATCH SIMPLE: membership is enforced when both parent IDs are present.
  membership    OpportunityAccount? @relation("TaskMembership", fields: [opportunityId, accountId], references: [opportunityId, accountId], onDelete: Restrict, onUpdate: Restrict)
  assignedToId  Int?
  assignedTo    User?               @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  subject       String
  description   String?
  dueDate       DateTime?
  status        TaskStatus          @default(OPEN)
  priority      TaskPriority        @default(NORMAL)
  completedAt   DateTime?
  archivedAt    DateTime?
  createdById   Int?
  createdBy     User?               @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?               @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById  Int?
  archivedBy    User?               @relation("TaskArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([assignedToId, status, dueDate])
  @@index([projectId, status])
  @@index([accountId, status])
  @@index([opportunityId, status])
  @@index([opportunityId, accountId])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model Activity {
  id            Int               @id @default(autoincrement())
  projectId     Int?
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId     Int?
  account       Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  opportunityId Int?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  userId        Int?
  user          User?             @relation("ActivityUser", fields: [userId], references: [id], onDelete: Restrict)
  type          String
  activityType  ActivityType      @relation(fields: [type], references: [code], onDelete: Restrict, onUpdate: Restrict)
  subject       String
  description   String?
  direction     ActivityDirection @default(NA)
  outcome       String?
  nextStep      String?
  followUpDate  DateTime?
  contacts      ActivityContact[]
  activityDate  DateTime          @default(now())
  archivedAt    DateTime?
  createdById   Int?
  createdBy     User?             @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?             @relation("ActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById  Int?
  archivedBy    User?             @relation("ActivityArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([accountId, activityDate])
  @@index([projectId, activityDate])
  @@index([opportunityId, activityDate])
  @@index([userId, activityDate])
  @@index([type])
  @@index([opportunityId, accountId])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model ActivityContact {
  activityId Int
  contactId  Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([activityId, contactId])
  @@index([contactId, activityId])
}

model Note {
  id            Int                 @id @default(autoincrement())
  projectId     Int?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId     Int?
  account       Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  opportunityId Int?
  opportunity   Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  /// MATCH SIMPLE: membership is enforced when both parent IDs are present.
  membership    OpportunityAccount? @relation("NoteMembership", fields: [opportunityId, accountId], references: [opportunityId, accountId], onDelete: Restrict, onUpdate: Restrict)
  body          String
  archivedAt    DateTime?
  createdById   Int?
  createdBy     User?               @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   Int?
  updatedBy     User?               @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById  Int?
  archivedBy    User?               @relation("NoteArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([accountId, createdAt])
  @@index([projectId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([opportunityId, accountId])
  @@index([createdById])
  @@index([updatedById])
  @@index([archivedById])
}

model Project {
  id                 Int                  @id @default(autoincrement())
  name               String
  primaryAccountId   Int?
  primaryAccount     Account?             @relation("ProjectPrimaryAccount", fields: [primaryAccountId], references: [id], onDelete: Restrict)
  primaryAccountRole ProjectPartyRole
  ownerId            Int?
  owner              User?                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status             ProjectStatus        @default(PLANNING)
  description        String?
  startDate          DateTime?
  targetEndDate      DateTime?
  archivedAt         DateTime?
  createdById        Int
  createdBy          User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById        Int?
  updatedBy          User?                @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  participants       ProjectAccount[]
  opportunities      OpportunityProject[]
  tasks              Task[]
  activities         Activity[]
  notes              Note[]

  @@index([primaryAccountId, archivedAt])
  @@index([ownerId, status])
  @@index([status, archivedAt])
  @@index([createdById])
  @@index([updatedById])
}

model OpportunityProject {
  opportunityId Int
  projectId     Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@id([opportunityId, projectId])
  @@index([projectId, opportunityId])
}

model ProjectAccount {
  projectId Int
  accountId Int
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  account   Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  roles     ProjectAccountRole[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@id([projectId, accountId])
  @@index([accountId, projectId])
}

model ProjectAccountRole {
  projectId  Int
  accountId  Int
  role       ProjectPartyRole
  membership ProjectAccount   @relation(fields: [projectId, accountId], references: [projectId, accountId], onDelete: Restrict, onUpdate: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@id([projectId, accountId, role])
  @@index([role, projectId])
}

model TradeShow {
  id               Int               @id @default(autoincrement())
  name             String
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  location         String?
  timezone         String?
  description      String?           @db.Text
  marketingOwnerId Int?
  marketingOwner   User?             @relation("TradeShowMarketingOwner", fields: [marketingOwnerId], references: [id], onDelete: Restrict)
  archivedAt       DateTime?
  createdById      Int
  createdBy        User              @relation("TradeShowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      Int?
  updatedBy        User?             @relation("TradeShowUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedById     Int?
  archivedBy       User?             @relation("TradeShowArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  imports          TradeShowImport[]
  leads            TradeShowLead[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([archivedAt, startDate])
  @@index([marketingOwnerId])
}

model TradeShowImport {
  id             Int                   @id @default(autoincrement())
  tradeShowId    Int
  tradeShow      TradeShow             @relation(fields: [tradeShowId], references: [id], onDelete: Restrict)
  format         TradeShowImportFormat
  sourceFileName String
  sourceSheet    String
  fileSha256     String
  uploadedById   Int
  uploadedBy     User                  @relation("TradeShowImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  mappingId       Int?
  mapping         TradeShowImportMapping? @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  mappingName     String?
  uploadedAt     DateTime              @default(now())
  rowCount       Int                   @default(0)
  createdCount   Int                   @default(0)
  existingCount  Int                   @default(0)
  skippedCount   Int                   @default(0)
  createdAt      DateTime              @default(now())
  firstLeads     TradeShowLead[]

  @@unique([id, tradeShowId])
  @@index([tradeShowId, uploadedAt])
  @@index([mappingId])
}

/// Reusable header-to-normalized-field template. Mapping JSON contains no lead row data.
model TradeShowImportMapping {
  id                Int               @id @default(autoincrement())
  name              String
  headerFingerprint String
  mappings          Json
  createdById       Int
  createdBy         User              @relation("TradeShowImportMappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       Int?
  updatedBy         User?             @relation("TradeShowImportMappingUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  lastUsedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  imports           TradeShowImport[]

  @@index([headerFingerprint, archivedAt])
  @@index([archivedAt, name])
}

model TradeShowLead {
  id                      Int                 @id @default(autoincrement())
  tradeShowId             Int
  tradeShow               TradeShow           @relation(fields: [tradeShowId], references: [id], onDelete: Restrict)
  firstImportId           Int
  firstImport             TradeShowImport     @relation(fields: [firstImportId, tradeShowId], references: [id, tradeShowId], onDelete: Restrict)
  sourceKey               String
  /// Reserved for a proven attendee/scan ID. Badge Id is retained only in rawSourceData.
  sourceLeadId            String?
  sourceFileName          String
  sourceSheet             String
  sourceRow               Int
  capturedAt              DateTime?
  importedAt              DateTime            @default(now())
  rawSourceData           Json
  /// Explicitly approved preview corrections; rawSourceData always remains untouched.
  reviewedOverrides       Json?
  /// Uncorrected row identity retained when reviewed values change sourceKey.
  sourceOriginalKey       String?
  firstName               String
  lastName                String
  title                   String?
  email                   String?
  phone                   String?
  sourceCompany           String?
  sourceCompanyWebsite    String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  stateProvince           String?
  postalCode              String?
  country                 String?
  sourceNotes             String?             @db.Text
  productInterest         String?             @db.Text
  competitorSourceText    String?
  competitorId            Int?
  competitor              CompetitorOption?   @relation(fields: [competitorId], references: [id], onDelete: Restrict)
  currentProductBeingUsed String?
  customerPainPoints      String?             @db.Text
  assignedSalesRepUserId  Int?
  assignedSalesRep        User?               @relation("TradeShowLeadSalesRep", fields: [assignedSalesRepUserId], references: [id], onDelete: Restrict)
  status                  TradeShowLeadStatus @default(NEW)
  routing                 TradeShowLeadRouting @default(UNREVIEWED)
  routedPartnerAccountId  Int?
  routedPartnerAccount    Account?             @relation("TradeShowLeadRoutedPartner", fields: [routedPartnerAccountId], references: [id], onDelete: Restrict)
  referredAt              DateTime?
  referredByUserId        Int?
  referredBy              User?                @relation("TradeShowLeadReferrer", fields: [referredByUserId], references: [id], onDelete: Restrict)
  referralNotes           String?              @db.Text
  followUpAt              DateTime?
  lastContactedAt         DateTime?
  salesNotes              String?             @db.Text
  accountId               Int?
  account                 Account?            @relation("TradeShowLeadAccount", fields: [accountId], references: [id], onDelete: Restrict)
  contactId               Int?
  contact                 Contact?            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  convertedOpportunityId  Int?                 @unique
  convertedOpportunity    Opportunity?        @relation(fields: [convertedOpportunityId], references: [id], onDelete: Restrict)
  convertedAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([tradeShowId, sourceKey])
  @@index([tradeShowId, status])
  @@index([tradeShowId, routing])
  @@index([assignedSalesRepUserId, status])
  @@index([routedPartnerAccountId, routing])
  @@index([referredByUserId])
  @@index([email])
  @@index([accountId])
  @@index([contactId])
  @@index([convertedOpportunityId])
  @@index([firstImportId])
  @@index([tradeShowId, sourceOriginalKey])
}
