# Separate operational image. The existing web production Dockerfile stays unchanged.
FROM node:22.23.4-bookworm-slim AS node-runtime
FROM postgres:17-bookworm
# PostgreSQL's base already supplies openssl/libstdc++; Node uses its bundled CA
# roots for Spaces HTTPS, and libpq uses the explicitly supplied managed DB CA.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /app
COPY scripts/operations/recovery-runtime/package*.json ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma.config.ts ./
COPY scripts/prisma-generate.mjs ./scripts/prisma-generate.mjs
RUN npm ci --omit=dev
COPY scripts/operations/recovery-common.mjs scripts/operations/backup-spaces.mjs scripts/operations/backup-postgres.mjs scripts/operations/restore-postgres.mjs scripts/operations/validate-restored-postgres.mjs ./scripts/operations/
COPY prisma/migrations ./prisma/migrations
USER postgres
ENTRYPOINT []
CMD ["node", "scripts/operations/backup-postgres.mjs"]
