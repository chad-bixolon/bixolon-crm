# Separate install and operational runtimes; npm never enters the final image.
FROM node:22.23.4-bookworm-slim AS node-runtime
RUN npm install --global npm@12.2.1 && test "$(npm --version)" = "12.2.1"

# Build on the target platform (Docker's default), matching the PostgreSQL runtime.
# Same gosu 1.19 source, with a supported compiler fixing CVE-2025-68121 and
# subsequent Go advisories. Only the static executable enters the final image.
FROM golang:1.26.10-bookworm@sha256:23ce71337b726608afb1bc00986e630a05034a87a87ea1fc2cd1ae5cf33387eb AS gosu-builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
# Tag 1.19 = commit 6456aaa0f3c854d199d0f037f068eb97515b7513.
# Use its canonical module version so Go/SBOM metadata retains source identity.
RUN go mod download -json github.com/tianon/gosu@v0.0.0-20250923190938-6456aaa0f3c8 > /tmp/gosu-source.json \
    && grep -F '"Sum": "h1:HIpXk5mGBQGfOqcaBbRT4Vnss8NPICnMGlD5xTlPBdQ="' /tmp/gosu-source.json \
    && GOBIN=/out go install -trimpath -ldflags='-d -w' github.com/tianon/gosu@v0.0.0-20250923190938-6456aaa0f3c8 \
    && go version -m /out/gosu

FROM postgres:17-bookworm AS operations-dependencies
# PostgreSQL's base already supplies openssl/libstdc++; Node uses its bundled CA
# roots for Spaces HTTPS, and libpq uses the explicitly supplied managed DB CA.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /app
COPY scripts/operations/recovery-runtime/package*.json ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma.config.ts ./
COPY scripts/prisma-generate.mjs ./scripts/prisma-generate.mjs
RUN npm ci --omit=dev

FROM postgres:17-bookworm AS operations
WORKDIR /app
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=operations-dependencies /app /app
COPY scripts/operations/recovery-common.mjs scripts/operations/backup-spaces.mjs scripts/operations/backup-postgres.mjs scripts/operations/restore-postgres.mjs scripts/operations/validate-restored-postgres.mjs ./scripts/operations/
COPY prisma/migrations ./prisma/migrations
COPY --from=gosu-builder --chmod=0755 /out/gosu /usr/local/bin/gosu
USER postgres
ENTRYPOINT []
CMD ["node", "scripts/operations/backup-postgres.mjs"]
