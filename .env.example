POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_SYNC_SECRET=
ENABLE_DEV_IMPERSONATION=false
SPACES_BUCKET=bixolon-saleshub-documents
SPACES_REGION=atl1
SPACES_ENDPOINT=https://atl1.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_PREFIX=dev

# Support Gmail: production only; keep disabled for local development.
SUPPORT_GMAIL_ENABLED=false
SUPPORT_GMAIL_CLIENT_ID=
SUPPORT_GMAIL_CLIENT_SECRET=
SUPPORT_GMAIL_OAUTH_CALLBACK_URL=
SUPPORT_GMAIL_MAILBOX=support@bixolonusa.com
SUPPORT_GMAIL_ENCRYPTION_KEY=
SUPPORT_GMAIL_EXPECTED_DATABASE_IDENTITY=
SUPPORT_GMAIL_INITIAL_LOOKBACK_DAYS=30

# Weekly snapshots: same secret on web service and scheduled job; 32+ random characters.
WEEKLY_SNAPSHOT_SECRET=
# Scheduled HTTP trigger only (HTTPS web-service origin, no path/credentials).
SALESHUB_JOB_ORIGIN=

# Backup/restore operational job only; never give these to the normal web service.
# Names only: see app/docs/backup-restore-rollback-v1.md for runtime configuration.
# Keep NODE_DEBUG and NODE_DEBUG_NATIVE unset for operational credential privacy.
BACKUP_DATABASE_URL=
BACKUP_DATABASE_NAME=
BACKUP_PG_CA_PEM=
BACKUP_ENVIRONMENT=
BACKUP_DOCUMENTS_BUCKET=
BACKUP_SPACES_BUCKET=
BACKUP_SPACES_REGION=
BACKUP_SPACES_ENDPOINT=
BACKUP_SPACES_ACCESS_KEY_ID=
BACKUP_SPACES_SECRET_ACCESS_KEY=
BACKUP_TEMP_DIR=
BACKUP_MAX_DUMP_BYTES=
# Optional safe deployed identity (existing release setting).
RELEASE_GIT_SHA=
# Restore job: production identity may be passwordless; target must be disposable.
RESTORE_PRODUCTION_DATABASE_URL=
RESTORE_TARGET_DATABASE_URL=
RESTORE_OBJECT_KEY=
RESTORE_EXPECTED_SHA256=
RESTORE_CONFIRM=
RESTORE_MODE=
RESTORE_ALLOW_CLEAN=
